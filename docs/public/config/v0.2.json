{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "port": {
            "default": 3000,
            "description": "The port the API listens on.",
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "x-env": "PORT"
        },
        "log": {
            "description": "Logging to standard output: JSON lines when NODE_ENV is production, readable text otherwise.",
            "default": {},
            "type": "object",
            "properties": {
                "level": {
                    "default": "info",
                    "type": "string",
                    "enum": [
                        "trace",
                        "debug",
                        "info",
                        "warn",
                        "error",
                        "fatal"
                    ],
                    "x-env": "LOG_LEVEL"
                }
            }
        },
        "postgres": {
            "type": "object",
            "properties": {
                "hostname": {
                    "type": "string",
                    "x-env": "POSTGRES_HOSTNAME"
                },
                "port": {
                    "description": "Defaults to the PostgreSQL port, 5432.",
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535,
                    "x-env": "POSTGRES_PORT"
                },
                "database": {
                    "type": "string",
                    "x-env": "POSTGRES_DATABASE"
                },
                "username": {
                    "type": "string",
                    "x-env": "POSTGRES_USERNAME"
                },
                "password": {
                    "type": "string",
                    "x-env": "POSTGRES_PASSWORD"
                },
                "poolSize": {
                    "default": 10,
                    "description": "The most connections the pool opens in each process; a process running jobs holds one more outside it, to hear about new jobs. At least 2, since booting holds a lock on one connection while migrating on another, so a pool of one cannot boot. A standalone worker needs its worker.runtime.concurrency plus 2.",
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 9007199254740991,
                    "x-env": "POSTGRES_POOL_SIZE"
                },
                "connectionTimeout": {
                    "default": 10000,
                    "description": "Milliseconds to wait for a database connection, both when opening one and when waiting for a free one from the pool.",
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991,
                    "x-env": "POSTGRES_CONNECTION_TIMEOUT"
                }
            },
            "required": [
                "hostname",
                "database",
                "username",
                "password"
            ],
            "description": "The PostgreSQL database."
        },
        "jwt": {
            "type": "object",
            "properties": {
                "issuer": {
                    "type": "string",
                    "description": "The OpenID Connect issuer. Its discovery document is fetched at startup, so the API does not start while the issuer is unreachable.",
                    "x-env": "JWT_ISSUER"
                },
                "audience": {
                    "type": "string",
                    "description": "The audience access tokens must carry.",
                    "x-env": "JWT_AUDIENCE"
                },
                "algorithms": {
                    "default": [
                        "RS256"
                    ],
                    "description": "The signature algorithms accepted on access tokens. Asymmetric only: tokens are verified against the issuer's published keys, so shared-secret HS256 and its siblings are not supported.",
                    "minItems": 1,
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "RS256",
                            "RS384",
                            "RS512",
                            "PS256",
                            "PS384",
                            "PS512",
                            "ES256",
                            "ES384",
                            "ES512",
                            "EdDSA"
                        ]
                    },
                    "x-env": "JWT_ALGORITHMS_<n>"
                },
                "superAdminPredicate": {
                    "description": "A JMESPath expression evaluated against the verified token; a truthy result makes the caller a super admin. Guard a claim that may be absent, as in the second example. An expression that fails to evaluate counts as false.",
                    "type": "string",
                    "examples": [
                        "sub == 'a' || sub == 'b'",
                        "contains(realm_access.roles || `[]`, 'superadmin')"
                    ],
                    "x-env": "JWT_SUPER_ADMIN_PREDICATE"
                },
                "integrationPredicate": {
                    "description": "A JMESPath expression evaluated against the verified token; a truthy result makes the caller the trusted integration that reads the published schedule. Written like superAdminPredicate.",
                    "type": "string",
                    "examples": [
                        "sub == 'integration'"
                    ],
                    "x-env": "JWT_INTEGRATION_PREDICATE"
                },
                "debug": {
                    "default": false,
                    "description": "Puts the reason a token was rejected into the 401 response. For debugging only: it tells every client why verification failed.",
                    "type": "boolean",
                    "x-env": "JWT_DEBUG"
                }
            },
            "required": [
                "issuer",
                "audience",
                "superAdminPredicate",
                "integrationPredicate"
            ],
            "description": "Verifying the access tokens the sign-in provider issues."
        },
        "userInfo": {
            "description": "Reading a person's name and email address from the sign-in provider's userinfo endpoint.",
            "default": {},
            "type": "object",
            "properties": {
                "emailAddressPath": {
                    "description": "A JMESPath expression picking the email address out of the provider's userinfo response. Left unset, people enter their address themselves.",
                    "type": "string",
                    "examples": [
                        "email"
                    ],
                    "x-env": "USER_INFO_EMAIL_ADDRESS_PATH"
                },
                "displayNamePath": {
                    "description": "A JMESPath expression picking the display name out of the provider's userinfo response. Left unset, people enter their name themselves.",
                    "type": "string",
                    "examples": [
                        "name",
                        "join(' ', [given_name, family_name][?@])"
                    ],
                    "x-env": "USER_INFO_DISPLAY_NAME_PATH"
                },
                "cacheTtl": {
                    "description": "How long a userinfo response is reused. An ISO 8601 duration in time units only.",
                    "default": "PT5M",
                    "type": "string",
                    "format": "duration",
                    "examples": [
                        "PT30S",
                        "PT6H"
                    ],
                    "x-env": "USER_INFO_CACHE_TTL"
                }
            }
        },
        "cors": {
            "type": "object",
            "properties": {
                "origin": {
                    "type": "string",
                    "description": "The web app's origin exactly as a browser sends it: lowercase scheme and host, plus the port only when it is not the default, with no path or trailing slash.",
                    "examples": [
                        "https://eventail.example.com"
                    ],
                    "x-env": "CORS_ORIGIN"
                }
            },
            "required": [
                "origin"
            ],
            "description": "Cross-origin requests from the web app."
        },
        "s3": {
            "type": "object",
            "properties": {
                "client": {
                    "type": "object",
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "description": "The store's URL.",
                            "x-env": "S3_CLIENT_ENDPOINT"
                        },
                        "credentials": {
                            "description": "Left unset, the AWS default credential chain applies, such as AWS_* environment variables or an instance role. An empty value counts as set.",
                            "type": "object",
                            "properties": {
                                "accessKeyId": {
                                    "type": "string",
                                    "x-env": "S3_CLIENT_CREDENTIALS_ACCESS_KEY_ID"
                                },
                                "secretAccessKey": {
                                    "type": "string",
                                    "x-env": "S3_CLIENT_CREDENTIALS_SECRET_ACCESS_KEY"
                                }
                            },
                            "required": [
                                "accessKeyId",
                                "secretAccessKey"
                            ]
                        },
                        "region": {
                            "description": "Falls back to AWS_REGION, then the region of the AWS profile in the shared config files, then EC2 instance metadata; AWS_DEFAULT_REGION is not read. Something has to set it even for stores without regions; us-east-1 works for those.",
                            "type": "string",
                            "x-env": "S3_CLIENT_REGION"
                        },
                        "forcePathStyle": {
                            "description": "Addresses the bucket as a path on the endpoint rather than as a subdomain. Most self-hosted stores need this.",
                            "type": "boolean",
                            "x-env": "S3_CLIENT_FORCE_PATH_STYLE"
                        }
                    },
                    "required": [
                        "endpoint"
                    ],
                    "description": "Connecting to the S3-compatible object store."
                },
                "requestHandler": {
                    "description": "Timeouts for each attempt at a request to the store. A stalling store is retried, so one request can take several times these.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "connectionTimeout": {
                            "default": 3000,
                            "description": "Milliseconds to wait for a connection to the store.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "S3_REQUEST_HANDLER_CONNECTION_TIMEOUT"
                        },
                        "socketTimeout": {
                            "default": 5000,
                            "description": "Milliseconds a request may go without data. Must stay below 6000, above which the client stops covering a stalled response body.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 5999,
                            "x-env": "S3_REQUEST_HANDLER_SOCKET_TIMEOUT"
                        }
                    }
                },
                "bucketName": {
                    "type": "string",
                    "minLength": 1,
                    "x-env": "S3_BUCKET_NAME"
                },
                "maxFileSize": {
                    "description": "The largest upload accepted, with a unit from B to TB.",
                    "type": "string",
                    "examples": [
                        "10mb",
                        "1.5GB"
                    ],
                    "x-env": "S3_MAX_FILE_SIZE"
                },
                "publicBaseUrl": {
                    "description": "The publicly reachable base URL of the bucket. Image URLs are this plus the object key.",
                    "type": "string",
                    "format": "uri",
                    "x-env": "S3_PUBLIC_BASE_URL"
                }
            },
            "required": [
                "client",
                "bucketName",
                "maxFileSize",
                "publicBaseUrl"
            ],
            "description": "The S3-compatible bucket holding uploads. Browsers upload to it directly, so it needs a CORS rule allowing POST from the web app's origin, and public images need a bucket policy."
        },
        "frontend": {
            "type": "object",
            "properties": {
                "baseUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "The web app's URL, used for the links in mails.",
                    "x-env": "FRONTEND_BASE_URL"
                }
            },
            "required": [
                "baseUrl"
            ],
            "description": "The web app."
        },
        "worker": {
            "description": "Background jobs and maintenance. The API runs a worker itself unless disableBuiltIn is set; standalone workers run the same image with ./worker.js.",
            "default": {},
            "type": "object",
            "properties": {
                "disableBuiltIn": {
                    "description": "Stops the API process from running jobs itself. Set it when standalone workers run, and only then: without either, no jobs run and no mail goes out.",
                    "type": "boolean",
                    "x-env": "WORKER_DISABLE_BUILT_IN"
                },
                "leader": {
                    "description": "Electing the one process that runs the maintenance tasks below, however many workers run.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "electionInterval": {
                            "description": "How often a process that is not the leader tries to become it. An ISO 8601 duration in time units only.",
                            "default": "PT1M",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_LEADER_ELECTION_INTERVAL"
                        },
                        "pollInterval": {
                            "description": "How often the leader checks that it still is. An ISO 8601 duration in time units only.",
                            "default": "PT1M",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_LEADER_POLL_INTERVAL"
                        }
                    }
                },
                "runtime": {
                    "description": "Claiming and running jobs.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "fallbackInterval": {
                            "description": "How often to look for jobs without being notified of one, covering missed notifications. An ISO 8601 duration in time units only.",
                            "default": "PT30S",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_RUNTIME_FALLBACK_INTERVAL"
                        },
                        "reconnectDelay": {
                            "description": "How long to wait before reconnecting after the database connection drops. An ISO 8601 duration in time units only.",
                            "default": "PT5S",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_RUNTIME_RECONNECT_DELAY"
                        },
                        "drainTimeout": {
                            "description": "How long shutting down waits for running jobs to finish. An ISO 8601 duration in time units only.",
                            "default": "PT15S",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_RUNTIME_DRAIN_TIMEOUT"
                        },
                        "maxAttempts": {
                            "default": 25,
                            "description": "How often a failing job is tried before it is given up.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "WORKER_RUNTIME_MAX_ATTEMPTS"
                        },
                        "concurrency": {
                            "default": 1,
                            "description": "Jobs a standalone worker runs at once; the built-in worker always runs one. Needs postgres.poolSize of at least this plus 2.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "WORKER_RUNTIME_CONCURRENCY"
                        }
                    }
                },
                "scheduler": {
                    "description": "Makes scheduled jobs and jobs due for a retry available.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "interval": {
                            "description": "An ISO 8601 duration in time units only.",
                            "default": "PT5S",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_SCHEDULER_INTERVAL"
                        },
                        "limit": {
                            "default": 1000,
                            "description": "Jobs handled per batch.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "WORKER_SCHEDULER_LIMIT"
                        }
                    }
                },
                "cleaner": {
                    "description": "Deletes finished jobs once their retention period, an ISO 8601 duration, has passed.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "interval": {
                            "description": "An ISO 8601 duration in time units only.",
                            "default": "PT30S",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_CLEANER_INTERVAL"
                        },
                        "canceledJobRetentionPeriod": {
                            "default": "PT24H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT1H"
                            ],
                            "x-env": "WORKER_CLEANER_CANCELED_JOB_RETENTION_PERIOD"
                        },
                        "completedJobRetentionPeriod": {
                            "default": "PT24H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT1H"
                            ],
                            "x-env": "WORKER_CLEANER_COMPLETED_JOB_RETENTION_PERIOD"
                        },
                        "discardedJobRetentionPeriod": {
                            "default": "P7D",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT1H"
                            ],
                            "x-env": "WORKER_CLEANER_DISCARDED_JOB_RETENTION_PERIOD"
                        }
                    }
                },
                "inviteSweeper": {
                    "description": "Deletes expired invites.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "interval": {
                            "description": "An ISO 8601 duration in time units only.",
                            "default": "PT1H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_INVITE_SWEEPER_INTERVAL"
                        }
                    }
                },
                "userSweeper": {
                    "description": "Deletes accounts nobody has used for the retention period, unless they host a session or belong to a team.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "interval": {
                            "description": "An ISO 8601 duration in time units only.",
                            "default": "PT6H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_USER_SWEEPER_INTERVAL"
                        },
                        "retentionPeriod": {
                            "description": "How long an account may go without its owner opening the web app. An ISO 8601 duration.",
                            "default": "P180D",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "P365D"
                            ],
                            "x-env": "WORKER_USER_SWEEPER_RETENTION_PERIOD"
                        }
                    }
                },
                "filePruner": {
                    "description": "Deletes objects in the bucket that nothing refers to anymore, and uploads that were never finished.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "interval": {
                            "description": "An ISO 8601 duration in time units only.",
                            "default": "PT24H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_FILE_PRUNER_INTERVAL"
                        },
                        "minimumAge": {
                            "description": "The least time an object stays unreferenced before it is deleted, counted from when the pruner first finds it so; unfinished uploads count from when they were uploaded. The deletion itself waits for the next run after that. An ISO 8601 duration.",
                            "default": "PT24H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT1H"
                            ],
                            "x-env": "WORKER_FILE_PRUNER_MINIMUM_AGE"
                        }
                    }
                },
                "rescuer": {
                    "description": "Makes a job that has been running longer than rescueAfter available again, taking its worker to be gone, or gives it up after worker.runtime.maxAttempts. A job still running then runs twice, so rescueAfter has to exceed the longest job.",
                    "default": {},
                    "type": "object",
                    "properties": {
                        "interval": {
                            "description": "An ISO 8601 duration in time units only.",
                            "default": "PT30S",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT30S",
                                "PT6H"
                            ],
                            "x-env": "WORKER_RESCUER_INTERVAL"
                        },
                        "limit": {
                            "default": 1000,
                            "description": "Jobs handled per batch.",
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "WORKER_RESCUER_LIMIT"
                        },
                        "rescueAfter": {
                            "description": "How long a job may run before it counts as stuck. An ISO 8601 duration.",
                            "default": "PT1H",
                            "type": "string",
                            "format": "duration",
                            "examples": [
                                "PT1H"
                            ],
                            "x-env": "WORKER_RESCUER_RESCUE_AFTER"
                        }
                    }
                }
            }
        },
        "email": {
            "type": "object",
            "properties": {
                "sender": {
                    "type": "string",
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
                    "description": "The From address of every mail.",
                    "x-env": "EMAIL_SENDER"
                },
                "confirmReminderCooldown": {
                    "description": "How long after one reminder to confirm a session the next may be sent. An ISO 8601 duration.",
                    "default": "P3D",
                    "type": "string",
                    "format": "duration",
                    "examples": [
                        "PT1H"
                    ],
                    "x-env": "EMAIL_CONFIRM_REMINDER_COOLDOWN"
                },
                "smtp": {
                    "default": {},
                    "description": "The mail server, passed to nodemailer's SMTP transport; its documentation covers each option. Timeouts are in milliseconds.",
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string",
                            "minLength": 1,
                            "x-env": "EMAIL_SMTP_HOST"
                        },
                        "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65535,
                            "x-env": "EMAIL_SMTP_PORT"
                        },
                        "auth": {
                            "description": "Left unset, no authentication is sent.",
                            "type": "object",
                            "properties": {
                                "user": {
                                    "type": "string",
                                    "x-env": "EMAIL_SMTP_AUTH_USER"
                                },
                                "pass": {
                                    "type": "string",
                                    "x-env": "EMAIL_SMTP_AUTH_PASS"
                                }
                            },
                            "required": [
                                "user",
                                "pass"
                            ]
                        },
                        "authMethod": {
                            "type": "string",
                            "x-env": "EMAIL_SMTP_AUTH_METHOD"
                        },
                        "secure": {
                            "description": "Speaks TLS from the start. Unset, only port 465 does; elsewhere TLS depends on the server offering STARTTLS, unless requireTLS demands it or ignoreTLS skips it.",
                            "type": "boolean",
                            "x-env": "EMAIL_SMTP_SECURE"
                        },
                        "tls": {
                            "description": "TLS options passed to Node.js.",
                            "type": "object",
                            "properties": {
                                "rejectUnauthorized": {
                                    "type": "boolean",
                                    "x-env": "EMAIL_SMTP_TLS_REJECT_UNAUTHORIZED"
                                },
                                "servername": {
                                    "type": "string",
                                    "minLength": 1,
                                    "x-env": "EMAIL_SMTP_TLS_SERVERNAME"
                                }
                            }
                        },
                        "ignoreTLS": {
                            "type": "boolean",
                            "x-env": "EMAIL_SMTP_IGNORE_TLS"
                        },
                        "requireTLS": {
                            "type": "boolean",
                            "x-env": "EMAIL_SMTP_REQUIRE_TLS"
                        },
                        "opportunisticTLS": {
                            "type": "boolean",
                            "x-env": "EMAIL_SMTP_OPPORTUNISTIC_TLS"
                        },
                        "name": {
                            "type": "string",
                            "minLength": 1,
                            "x-env": "EMAIL_SMTP_NAME"
                        },
                        "localAddress": {
                            "type": "string",
                            "minLength": 1,
                            "x-env": "EMAIL_SMTP_LOCAL_ADDRESS"
                        },
                        "connectionTimeout": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "EMAIL_SMTP_CONNECTION_TIMEOUT"
                        },
                        "greetingTimeout": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "EMAIL_SMTP_GREETING_TIMEOUT"
                        },
                        "socketTimeout": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "EMAIL_SMTP_SOCKET_TIMEOUT"
                        },
                        "dnsTimeout": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "EMAIL_SMTP_DNS_TIMEOUT"
                        },
                        "pool": {
                            "type": "boolean",
                            "x-env": "EMAIL_SMTP_POOL"
                        },
                        "maxConnections": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "EMAIL_SMTP_MAX_CONNECTIONS"
                        },
                        "maxMessages": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991,
                            "x-env": "EMAIL_SMTP_MAX_MESSAGES"
                        }
                    }
                }
            },
            "required": [
                "sender"
            ],
            "description": "Sending mail."
        }
    },
    "required": [
        "postgres",
