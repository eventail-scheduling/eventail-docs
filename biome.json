{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "files": {
        "includes": [
            "biome.json",
            "commitlint.config.cjs",
            "package.json",
            "tsconfig.json",
            "docs/.vitepress/**/*.ts",
            "docs/.vitepress/**/*.vue"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noExcessiveCognitiveComplexity": "warn",
                "useSimplifiedLogicExpression": "error"
            },
            "correctness": {
                "noUnusedImports": "error",
                "noUnusedVariables": {
                    "level": "error",
                    "options": {
                        "ignoreRestSiblings": true
                    }
                }
            },
            "style": {
                "useBlockStatements": "error",
                "useCollapsedElseIf": "error",
                "useForOf": "error",
                "useShorthandAssign": "error",
                "useConsistentArrayType": {
                    "level": "error",
                    "options": {
                        "syntax": "shorthand"
                    }
                }
            },
            "suspicious": {
                "noEmptyBlockStatements": "error"
            }
        }
    },
    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true
        }
    }
}
